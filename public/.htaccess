# =============================================================================
# Apache — à placer à la RACINE du site (même niveau que index.html)
# Astro : ce fichier est dans public/ et est copié dans dist/ au build (npm run build).
# Hébergeur type o2switch : vérifier que AllowOverride autorise FileInfo / Indexes.
# =============================================================================

# Pages par défaut dans chaque dossier (ex. /contact/ → contact/index.html)
DirectoryIndex index.html

# Page d'erreur personnalisée (générée par Astro : src/pages/404.astro → dist/404.html)
ErrorDocument 404 /404.html

# Pas de listing des dossiers ; liens symboliques suivis si besoin du serveur
Options -Indexes
<IfModule mod_negotiation.c>
	Options -MultiViews
</IfModule>

# Encodage par défaut
AddDefaultCharset UTF-8

# Types MIME utiles (si le serveur ne les connaît pas)
<IfModule mod_mime.c>
	AddType image/webp .webp
	AddType font/woff2 .woff2
</IfModule>

# -----------------------------------------------------------------------------
# Compression (réduit le poids des textes : HTML, CSS, JS, SVG, JSON…)
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
	AddOutputFilterByType DEFLATE application/javascript application/json application/xml
	AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# Cache navigateur — HTML court ; assets statiques longs (images, /_astro/*.css|js)
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresDefault "access plus 1 hour"
	ExpiresByType text/html "access plus 0 seconds"
	ExpiresByType image/png "access plus 1 year"
	ExpiresByType image/jpeg "access plus 1 year"
	ExpiresByType image/webp "access plus 1 year"
	ExpiresByType image/svg+xml "access plus 1 year"
	ExpiresByType image/x-icon "access plus 1 year"
	ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType text/css "access plus 1 year"
	ExpiresByType application/javascript "access plus 1 year"
	ExpiresByType text/javascript "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
	# HTML : cache court + revalidation
	<FilesMatch "\.(html)$">
		Header set Cache-Control "public, max-age=3600, must-revalidate"
	</FilesMatch>
	# Sécurité de base (ajustez X-Frame-Options si vous devez embedder le site ailleurs)
	Header set X-Content-Type-Options "nosniff"
	Header set X-Frame-Options "SAMEORIGIN"
	Header set Referrer-Policy "strict-origin-when-cross-origin"
	# HSTS : le navigateur ne passe plus que par HTTPS (1 an). Volontairement SANS includeSubDomains ni preload,
	# pour ne pas bloquer d'éventuels sous-domaines (webmail, mail…) sans certificat valide.
	# (Les navigateurs ignorent cet en-tête sur les réponses en HTTP simple : sans risque.)
	Header set Strict-Transport-Security "max-age=31536000"
</IfModule>

# -----------------------------------------------------------------------------
# Réécritures (HTTPS, www, etc.) — décommentez et adaptez si besoin
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /

	# --- Redirections 301 du repositionnement (09/2026) : une seule étape, sans chaîne ---
	# Pages de services fusionnées
	RewriteRule ^expert-google-sheets-entreprise/?$ https://emmanuelsauvage.fr/automatisation-google-sheets/ [R=301,L]
	RewriteRule ^automatisation-entreprise/?$ https://emmanuelsauvage.fr/automatisation-google-sheets/ [R=301,L]
	RewriteRule ^audit-outils-digitaux/?$ https://emmanuelsauvage.fr/developpement-application-sur-mesure/ [R=301,L]
	# Articles de blog fusionnés
	RewriteRule ^blog/refonte-ou-maintenance-application/?$ https://emmanuelsauvage.fr/blog/refonte-application-web-signaux-strategie-dette-technique/ [R=301,L]
	RewriteRule ^blog/(openapi-contrat-api-equipes|problem-details-rfc9457-symfony|webhooks-idempotence-cles-pratique|api-donnees-personnelles-minimisation-rgpd)/?$ https://emmanuelsauvage.fr/blog/versionner-api-rest-symfony/ [R=301,L]
	RewriteRule ^blog/maintenance-symfony-production-indicateurs/?$ https://emmanuelsauvage.fr/refonte-application-web/ [R=301,L]

	# Dossier demandé sans « / » final (ex. http://www.emmanuelsauvage.fr/contact) :
	# une seule redirection 301 directement vers l'URL canonique https://emmanuelsauvage.fr/contact/
	# (sinon : http → https, puis ajout du slash par Apache = 2 sauts).
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteCond %{REQUEST_URI} !/$
	RewriteRule ^(.+)$ https://emmanuelsauvage.fr/$1/ [L,R=301]

	# Canonicalisation domaine + protocole (évite les chaînes de redirections).
	# - force HTTPS
	# - force sans www
	RewriteCond %{HTTPS} !=on [OR]
	RewriteCond %{HTTP_HOST} ^www\.emmanuelsauvage\.fr$ [NC]
	RewriteRule ^ https://emmanuelsauvage.fr%{REQUEST_URI} [L,R=301]
</IfModule>

# -----------------------------------------------------------------------------
# Fichiers sensibles (si jamais présents sur le serveur)
# -----------------------------------------------------------------------------
<FilesMatch "^(\.htaccess|\.htpasswd|\.env|composer\.json|package\.json)$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
</FilesMatch>
