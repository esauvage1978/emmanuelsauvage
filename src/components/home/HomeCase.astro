---
import { caseStudy } from '../../data/home';
import HomeIcon from './HomeIcon.astro';
---

<!--
	Cas Decathlon décrit à partir de la mission « Suivi Bilan SST » publiée sur le profil Malt d’Emmanuel
	(chiffres repris de cette source). Publication autorisée par Decathlon (28/09/2026).
-->
<section class="homeCase homeSection homeSection--alt" aria-labelledby="home-case-heading">
	<div class="homeContainer">
		<div class="homeCase__box">
			<div class="homeCase__head">
				<p class="homeCase__eyebrow">{caseStudy.eyebrow}</p>
				<h2 id="home-case-heading" class="homeSection__title">{caseStudy.title}</h2>
				<a class="homeLink" href={caseStudy.link.href}>
					{caseStudy.link.label}
					<HomeIcon name="arrow" />
				</a>
			</div>
			<dl class="homeCase__lines">
				{
					caseStudy.lines.map((line) => (
						<div>
							<dt>{line.label}</dt>
							<dd>{line.text}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</div>
</section>

<style>
	.homeCase__box {
		display: grid;
		gap: 24px;
		padding: clamp(24px, 4vw, 40px);
		border-radius: var(--home-radius-lg);
		background: var(--home-slate-50);
		border: 1px solid #e2e8f0;
	}

	@media (min-width: 900px) {
		.homeCase__box {
			grid-template-columns: 0.8fr 1.2fr;
			gap: 40px;
			align-items: start;
		}
	}

	.homeCase__eyebrow {
		margin: 0 0 8px;
		font-size: 12px;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #c2410c;
	}

	.homeCase__lines {
		display: grid;
		gap: 14px;
		margin: 0;
	}

	.homeCase__lines > div {
		display: grid;
		gap: 4px;
		padding: 14px 16px;
		border-radius: var(--home-radius);
		background: #fff;
		border-left: 3px solid var(--home-blue);
	}

	@media (min-width: 640px) {
		.homeCase__lines > div {
			grid-template-columns: 140px 1fr;
			gap: 16px;
		}
	}

	.homeCase__lines dt {
		font-weight: 700;
		color: var(--home-navy);
	}

	.homeCase__lines dd {
		margin: 0;
		font-size: 15px;
		line-height: 1.55;
	}
</style>
