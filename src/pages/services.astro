---
import OfferLayout from '../layouts/OfferLayout.astro';

const title = 'Services : formation Google Sheets, applications et sites';
const description =
	'Les 3 offres d’Emmanuel Sauvage : formation Google Sheets et Apps Script, automatisation et applications métier sur mesure, création de sites internet.';
const h1 = 'Services : former, automatiser, développer';
const lead =
	'Trois offres complémentaires, du tableur à l’application : former vos équipes à Google Sheets, automatiser vos fichiers ou développer l’outil métier dont vous avez besoin, et créer un site qui vous amène des demandes.';

const groups = [
	{
		tag: 'Offre 1',
		title: 'Formation Google Sheets',
		href: '/formation-google-sheets/',
		text: 'Des programmes par niveau, sur vos fichiers, en présentiel dans vos locaux (Lille et Hauts-de-France) ou à distance. Finançable OPCO via notre organisme partenaire certifié Qualiopi.',
		links: [
			{ label: 'Formation Google Sheets (N1 à N3, Excel vers Sheets)', href: '/formation-google-sheets/' },
			{ label: 'Formation Google Apps Script', href: '/formation-apps-script/' },
		],
	},
	{
		tag: 'Offre 2',
		title: 'Applications sur mesure',
		href: '/developpement-application-sur-mesure/',
		text: 'Des applications métier développées plus vite grâce à l’IA, des automatisations Google Sheets, et la maintenance de l’existant.',
		links: [
			{ label: 'Développement d’application sur mesure', href: '/developpement-application-sur-mesure/' },
			{ label: 'Automatisation Google Sheets et Apps Script', href: '/automatisation-google-sheets/' },
			{ label: 'Refonte et maintenance d’application web', href: '/refonte-application-web/' },
			{ label: 'Développeur Symfony freelance (agences, ESN, DSI)', href: '/developpeur-symfony-freelance/' },
		],
	},
	{
		tag: 'Offre 3',
		title: 'Sites internet',
		href: '/creation-site-internet/',
		text: 'Des sites vitrines rapides et bien référencés à Lille et Armentières, avec des formulaires connectés à vos outils.',
		links: [{ label: 'Création et refonte de site internet', href: '/creation-site-internet/' }],
	},
];
---

<OfferLayout
	title={title}
	description={description}
	h1={h1}
	lead={lead}
	eyebrow="Services"
	breadcrumb={[{ label: 'Services' }]}
	primaryCta={{ label: 'Parler de mon projet', href: '/contact/' }}
	secondaryCta={{ label: 'Voir les réalisations', href: '/realisations/' }}
	current="services"
>
	<section class="oSection" aria-label="Les offres">
		<div class="oContainer">
			<div class="oGrid oGrid--3">
				{
					groups.map((g) => (
						<article class="oCard">
							<span class="oCard__tag">{g.tag}</span>
							<h2 class="oTitle" style="font-size:1.25rem">
								<a href={g.href} style="color:inherit;text-decoration:none">
									{g.title}
								</a>
							</h2>
							<p>{g.text}</p>
							<ul>
								{g.links.map((l) => (
									<li>
										<a href={l.href}>{l.label}</a>
									</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="oSection oSection--alt" aria-labelledby="svc-parcours">
		<div class="oContainer">
			<h2 id="svc-parcours" class="oTitle">Du tableur à l’application</h2>
			<ol class="oSteps oSteps--3">
				<li><strong>Former</strong>Vos équipes maîtrisent Google Sheets et fiabilisent leurs fichiers.</li>
				<li><strong>Automatiser</strong>Apps Script prend le relais des tâches répétitives.</li>
				<li><strong>Développer</strong>Quand le tableur atteint ses limites, une application sur mesure prend le relais.</li>
			</ol>
		</div>
	</section>
</OfferLayout>
