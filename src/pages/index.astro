---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeProblems from '../components/home/HomeProblems.astro';
import HomeCase from '../components/home/HomeCase.astro';
import HomeServices from '../components/home/HomeServices.astro';
import HomeMethod from '../components/home/HomeMethod.astro';
import HomePortfolio from '../components/home/HomePortfolio.astro';
import HomeLogoStrip from '../components/home/HomeLogoStrip.astro';
import HomeTestimonials from '../components/home/HomeTestimonials.astro';
import HomeZone from '../components/home/HomeZone.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import HomeCta from '../components/home/HomeCta.astro';
import { homeMeta, faqItems } from '../data/home';
import { SITE_ADDRESS, SITE_AREA_SERVED, SITE_LOGO_URL, SITE_ORIGIN, SITE_SAME_AS } from '../config/site';

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqItems.map((item) => ({
		'@type': 'Question',
		name: item.question,
		acceptedAnswer: {
			'@type': 'Answer',
			text: item.answer,
		},
	})),
};

const offer = (name: string, path: string, description: string) => ({
	'@type': 'Offer',
	itemOffered: {
		'@type': 'Service',
		name,
		description,
		url: `${SITE_ORIGIN}${path}`,
		provider: { '@id': `${SITE_ORIGIN}/#business` },
	},
});

const localBusinessJsonLd = {
	'@context': 'https://schema.org',
	'@type': ['LocalBusiness', 'ProfessionalService'],
	'@id': `${SITE_ORIGIN}/#business`,
	name: 'Emmanuel Sauvage',
	url: SITE_ORIGIN,
	description: homeMeta.description,
	telephone: '+33609924945',
	email: 'contact@emmanuelsauvage.fr',
	logo: SITE_LOGO_URL,
	image: SITE_LOGO_URL,
	address: SITE_ADDRESS,
	areaServed: SITE_AREA_SERVED,
	founder: { '@id': `${SITE_ORIGIN}/#person` },
	sameAs: SITE_SAME_AS,
	hasOfferCatalog: {
		'@type': 'OfferCatalog',
		name: 'Formation, applications et sites web',
		itemListElement: [
			{
				'@type': 'OfferCatalog',
				name: 'Formation Google Sheets',
				itemListElement: [
					offer(
						'Formation Google Sheets en entreprise',
						'/formation-google-sheets/',
						'Formation Google Sheets en présentiel dans vos locaux (Lille et Hauts-de-France) ou à distance, du niveau débutant au niveau expert.',
					),
					offer(
						'Formation Google Apps Script',
						'/formation-apps-script/',
						'Formation à l’automatisation de Google Sheets avec Apps Script.',
					),
				],
			},
			{
				'@type': 'OfferCatalog',
				name: 'Applications sur mesure',
				itemListElement: [
					offer(
						'Développement d’application sur mesure',
						'/developpement-application-sur-mesure/',
						'Conception et développement d’applications métier sur mesure.',
					),
					offer(
						'Automatisation Google Sheets et Apps Script',
						'/automatisation-google-sheets/',
						'Automatisation de fichiers Google Sheets avec Apps Script.',
					),
					offer(
						'Refonte et maintenance d’application web',
						'/refonte-application-web/',
						'Maintenance, montée de version et refonte progressive d’applications métier.',
					),
					offer(
						'Développement Symfony freelance',
						'/developpeur-symfony-freelance/',
						'Renfort Symfony pour agences, ESN et DSI.',
					),
				],
			},
			{
				'@type': 'OfferCatalog',
				name: 'Sites internet',
				itemListElement: [
					offer(
						'Création de site internet',
						'/creation-site-internet/',
						'Création et refonte de sites vitrines rapides et optimisés pour le référencement.',
					),
				],
			},
		],
	},
};
---

<Layout
	title={homeMeta.title}
	description={homeMeta.description}
	preloadLcpHref="/images/hero-illustration-unsplash-2-662.webp"
	preloadLcpType="image/webp"
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />

	<SiteHeader current="home" />

	<main class="home">
		<HomeHero />
		<HomeProblems />
		<HomeCase />
		<HomeServices />
		<HomeMethod />
		<HomePortfolio />
		<HomeLogoStrip />
		<HomeTestimonials />
		<HomeZone />
		<HomeFaq />
		<HomeCta />
	</main>

	<SiteFooter discussHref="#contact" variant="home" />
</Layout>
