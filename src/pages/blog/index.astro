---
/**
 * Liste du blog : `/blog/` (liens internes toujours avec « / » final ; trailingSlash: 'ignore' dans astro.config.mjs).
 * Articles : collection `blog` (`src/content/blog/*.md`) + `src/content.config.ts`.
 */
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BlogCoverImage from '../../components/blog/BlogCoverImage.astro';

const rawPosts = await getCollection('blog');
const posts = rawPosts
	.map((p) => ({
		slug: p.id,
		title: p.data.title,
		description: p.data.description,
		pubDate: p.data.pubDate,
		readingTimeMinutes: p.data.readingTimeMinutes,
		tags: p.data.tags,
		illustration: p.data.illustration,
		category: p.data.category ?? 'applications',
	}))
	.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf());

const categories = [
	{
		id: 'google-sheets',
		label: 'Google Sheets',
		intro: 'Tutoriels et conseils pour mieux utiliser Google Sheets et Apps Script en entreprise.',
		cta: { label: 'Formation Google Sheets', href: '/formation-google-sheets/' },
	},
	{
		id: 'applications',
		label: 'Applications métier',
		intro: 'Remplacer ses fichiers, faire évoluer une application, choisir un prestataire, concevoir une API.',
		cta: { label: 'Applications sur mesure', href: '/developpement-application-sur-mesure/' },
	},
	{
		id: 'sites-web',
		label: 'Sites web',
		intro: 'Créer un site vitrine rapide, bien référencé et connecté à vos outils.',
		cta: { label: 'Création de site internet', href: '/creation-site-internet/' },
	},
] as const;

const groups = categories
	.map((c) => ({ ...c, posts: posts.filter((p) => p.category === c.id) }))
	.filter((g) => g.posts.length > 0);
---

<Layout
	title="Blog : Google Sheets, applications métier et sites web"
	description="Tutoriels Google Sheets et Apps Script, conseils sur les applications métier sur mesure et les sites web rapides : des articles pour les entreprises."
>
	<SiteHeader current="blog" />

	<main class="blogIndex">
		<div class="blogIndex__container">
			<header class="blogIndex__header">
				<h1>Blog : Google Sheets, applications métier et sites web</h1>
				<p>
					Des tutoriels Google Sheets pour vos équipes, des repères pour remplacer vos fichiers par une application, et
					des conseils pour un site qui vous amène des demandes.
				</p>
				<nav class="blogIndex__chips" aria-label="Rubriques du blog">
					{
						groups.map((g) => (
							<a href={`#${g.id}`}>
								{g.label} <span>({g.posts.length})</span>
							</a>
						))
					}
				</nav>
			</header>

			{
				groups.map((g) => (
					<section id={g.id} class="blogIndex__group" aria-labelledby={`cat-${g.id}`}>
						<div class="blogIndex__groupHead">
							<h2 id={`cat-${g.id}`}>{g.label}</h2>
							<p>
								{g.intro} <a href={g.cta.href}>{g.cta.label}</a>
							</p>
						</div>
			<ul class="blogIndex__list">
				{
					g.posts.map((post) => (
						<li>
							<article class="blogCard">
								<a class="blogCard__thumb" href={`/blog/${post.slug}/`} tabindex="-1" aria-hidden="true">
									<BlogCoverImage slug={post.slug} illustration={post.illustration} class="blogCard__cover" />
								</a>
								<div class="blogCard__body">
									<p class="blogCard__meta">
										<time datetime={post.pubDate.toISOString().slice(0, 10)}>
											{post.pubDate.toLocaleDateString('fr-FR', { dateStyle: 'long' })}
										</time>
										<span aria-hidden="true"> · </span>
										<span>{post.readingTimeMinutes} min</span>
									</p>
									<h3>
										<a href={`/blog/${post.slug}/`}>{post.title}</a>
									</h3>
									<p class="blogCard__desc">{post.description}</p>
									<ul class="blogCard__tags" aria-label="Thématiques">
										{post.tags.map((t) => (
											<li>{t}</li>
										))}
									</ul>
								</div>
							</article>
						</li>
					))
				}
			</ul>
					</section>
				))
			}

			<p class="blogIndex__credits">
				Vignettes : photos libres de droit via{' '}
				<a href="https://unsplash.com/" target="_blank" rel="noopener noreferrer">Unsplash</a> — voir{' '}
				<a href="/images/blog/CREDITS.md">crédits</a>.
			</p>
		</div>
	</main>

	<SiteFooter />
</Layout>

<style>
	.blogIndex__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 18px;
	}

	.blogIndex__chips a {
		padding: 8px 14px;
		border-radius: 999px;
		font-size: 14px;
		font-weight: 600;
		text-decoration: none;
		color: var(--color-primary);
		background: #fff;
		border: 1px solid rgba(47, 58, 143, 0.18);
	}

	.blogIndex__chips a:hover {
		border-color: var(--color-spot);
		color: var(--color-spot-hover);
	}

	.blogIndex__chips span {
		font-weight: 400;
		color: var(--color-muted);
	}

	.blogIndex__group {
		margin-top: 40px;
		scroll-margin-top: 90px;
	}

	.blogIndex__groupHead h2 {
		margin: 0 0 6px;
		font-size: clamp(1.3rem, 2.6vw, 1.6rem);
		color: var(--color-primary);
	}

	.blogIndex__groupHead p {
		margin: 0 0 18px;
		color: var(--color-muted);
	}

	.blogIndex__groupHead a {
		color: var(--color-spot-hover);
		font-weight: 600;
	}

	.blogIndex {
		background: var(--color-bg);
		min-width: 0;
		overflow-x: clip;
	}

	.blogIndex__container {
		width: min(960px, calc(100% - 32px));
		margin: 0 auto;
		padding: 32px 0 72px;
	}

	@media (min-width: 521px) {
		.blogIndex__container {
			width: min(960px, calc(100% - 48px));
			padding-top: 40px;
		}
	}

	.blogIndex__header {
		max-width: 62ch;
		margin-bottom: 36px;
		padding-bottom: 24px;
		border-bottom: 1px solid color-mix(in srgb, var(--color-border) 78%, rgba(196, 92, 46, 0.12));
	}

	.blogIndex__header h1 {
		margin: 0 0 12px;
		font-size: clamp(1.75rem, 4vw, 2.35rem);
		letter-spacing: -0.03em;
		color: var(--color-primary);
	}

	.blogIndex__header p {
		margin: 0;
		line-height: 1.6;
		color: var(--color-muted);
		font-size: 1.05rem;
	}

	.blogIndex__list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 18px;
	}

	.blogCard {
		display: grid;
		grid-template-columns: 120px 1fr;
		border-radius: var(--radius);
		border: 1px solid var(--color-border);
		background: rgba(255, 255, 255, 0.92);
		box-shadow: var(--shadow-sm);
		overflow: hidden;
		transition: box-shadow 0.18s ease, transform 0.18s ease;
	}

	@media (min-width: 640px) {
		.blogCard {
			grid-template-columns: 200px 1fr;
		}
	}

	.blogCard:hover {
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
	}

	.blogCard__thumb {
		display: block;
		overflow: hidden;
		min-height: 100px;
		line-height: 0;
	}

	.blogCard__cover {
		height: 100%;
		min-height: 100px;
		border-radius: 0;
	}

	.blogCard__cover :global(.blogCover),
	.blogCard__cover :global(.blogIllu) {
		height: 100%;
		min-height: 100px;
		border-radius: 0;
		border: none;
		box-shadow: none;
	}

	.blogCard__body {
		padding: 16px 18px 18px;
	}

	.blogCard__meta {
		margin: 0 0 8px;
		font-size: 13px;
		color: var(--color-muted);
	}

	.blogCard h3 {
		margin: 0 0 8px;
		font-size: 1.1rem;
		line-height: 1.3;
		letter-spacing: -0.02em;
	}

	@media (min-width: 640px) {
		.blogCard h3 {
			font-size: 1.2rem;
		}
	}

	.blogCard h3 a {
		color: var(--color-primary);
		text-decoration: none;
	}

	.blogCard h3 a:hover {
		text-decoration: underline;
		text-decoration-color: rgba(196, 92, 46, 0.45);
	}

	.blogCard__desc {
		margin: 0 0 12px;
		line-height: 1.55;
		color: var(--color-text);
		opacity: 0.92;
		font-size: 0.95rem;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
	}

	.blogCard__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px 10px;
		list-style: none;
		padding: 0;
		margin: 0;
		font-size: 11px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-spot-hover);
	}

	.blogIndex__credits {
		margin: 28px 0 0;
		font-size: 12px;
		color: var(--color-muted);
		text-align: center;
	}

	.blogIndex__credits a {
		color: var(--color-primary);
	}
</style>
