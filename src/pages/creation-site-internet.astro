---
import OfferLayout from '../layouts/OfferLayout.astro';
import { serviceJsonLd } from '../data/schema';
import { testimonials } from '../data/testimonials';

const title = 'Création site internet Lille & Armentières – rapide et SEO';
const description =
	'Sites vitrines rapides (100/100 PageSpeed), bien référencés et pensés pour générer des demandes. Freelance près de Lille et Armentières.';
const h1 = 'Création de site internet pour les entreprises de Lille et d’Armentières';
const lead =
	'Des sites ultra-rapides qui vous amènent des demandes, pas juste une carte de visite : pages de service claires, référencement local, formulaire de devis connecté, et des scores PageSpeed mesurés.';

const realisations = [
	{
		name: 'Hecker & Frères Énergie (HFE)',
		url: 'https://hfe-energie.fr/',
		image: '/images/realisations/hfe-energie.png',
		sector: 'Pompe à chaleur, climatisation & plomberie — Lille',
		description:
			'Site vitrine d’un installateur RGE QualiPAC : pages services, zone d’intervention, avis Google, FAQ et formulaire de devis. Optimisé pour le référencement local et la conversion.',
		tags: ['Site vitrine', 'SEO local', 'Performance 100/100'],
	},
	{
		name: 'Cabinet Beligat',
		url: 'https://podologue-beligat.fr/',
		image: '/images/realisations/podologue-beligat.png',
		sector: 'Pédicures-podologues — Armentières',
		description:
			'Présentation d’un cabinet de podologie : services, équipe, parcours semelles sur mesure et prise de rendez-vous Doctolib. Design sobre et rassurant pour un univers santé.',
		tags: ['Site vitrine', 'Santé', 'Prise de RDV'],
	},
	{
		name: 'EDAME',
		url: 'https://edame.fr/',
		image: '/images/realisations/edame.png',
		sector: 'Accompagnement scolaire & éducatif — Lille, Dunkerque',
		description:
			'Site d’une éducatrice spécialisée : présentation de l’offre, blog, FAQ et formulaire de premier contact. Identité douce et lisible, pensée pour les familles.',
		tags: ['Site vitrine', 'Blog', 'Formulaire de contact'],
	},
];

const faq = [
	{
		question: 'Quel type de sites internet créez-vous ?',
		answer:
			'Principalement des sites vitrines pour les TPE, PME, artisans et professions libérales : rapides, accessibles et optimisés pour le référencement. J’utilise Astro, qui produit des pages très légères sans plugins à maintenir.',
	},
	{
		question: 'Combien coûte un site vitrine ?',
		answer:
			'Le prix dépend du nombre de pages, de la rédaction des contenus et des fonctionnalités (formulaire connecté, blog, prise de rendez-vous). Je vous envoie un devis détaillé après un premier échange.',
	},
	{
		question: 'Mon site sera-t-il visible sur Google à Lille ou Armentières ?',
		answer:
			'Le site est construit pour le référencement local : pages de service, zone d’intervention, balisage structuré, vitesse et optimisation de votre fiche Google Business Profile. Personne ne peut garantir une position, mais ces fondations mettent toutes les chances de votre côté.',
	},
	{
		question: 'Pouvez-vous refaire mon site WordPress sans perdre mon référencement ?',
		answer:
			'Oui : reprise des contenus utiles, conservation ou redirection 301 des anciennes adresses, et mesure de la vitesse avant et après la refonte.',
	},
	{
		question: 'Pouvez-vous connecter le formulaire à mon CRM ou à Google Sheets ?',
		answer:
			'Oui : les demandes peuvent arriver par e-mail, s’enregistrer dans Google Sheets ou alimenter un CRM, par exemple via Zapier.',
	},
	{
		question: 'Pourquoi la performance est-elle importante ?',
		answer:
			'Un site rapide est mieux référencé, plus agréable sur mobile et convertit davantage. Les sites que je livre visent 100/100 sur PageSpeed en performance, accessibilité, bonnes pratiques et SEO.',
	},
];

const parafiniukQuote = testimonials.find((t) => t.author === 'Maître Iwona Parafiniuk');

const jsonLd = [
	serviceJsonLd({
		name: 'Création de site internet',
		path: '/creation-site-internet/',
		description,
		serviceType: 'Création de sites internet vitrines',
	}),
];
---

<OfferLayout
	title={title}
	description={description}
	h1={h1}
	lead={lead}
	eyebrow="Offre 3 · Sites internet"
	breadcrumb={[{ label: 'Création de site internet' }]}
	badges={['100/100 PageSpeed mesuré', 'SEO local Lille & Armentières', 'Formulaires connectés']}
	primaryCta={{ label: 'Demander un devis', href: '/contact/?offre=site' }}
	secondaryCta={{ label: 'Voir les réalisations', href: '#realisations' }}
	faq={faq}
	jsonLd={jsonLd}
	current="sites"
	ogImage="/images/og/creation-site-internet.png"
	finalCta={{
		title: 'Un projet de site ou un site à refaire ?',
		text: 'Présentez votre activité, votre zone et le site actuel s’il existe : je vous réponds avec une proposition et un devis.',
		primary: { label: 'Demander un devis', href: '/contact/?offre=site' },
		secondary: { label: 'Voir toutes les réalisations', href: '/realisations/' },
	}}
>
	<!-- TODO (Emmanuel) : re-mesurer les scores PageSpeed des sites clients avant publication ; obtenir l’accord de HFE, Beligat, EDAME et du cabinet Parafiniuk pour les citer ; résultats avant/après (positions, demandes) à collecter. -->
	<!-- Tarifs : sur devis (confirmé). TODO (Emmanuel) : hébergement et maintenance inclus ou non, possibilité pour le client de modifier ses contenus (CMS ?), délais, propriété du site et du nom de domaine. -->

	<section class="oSection" aria-labelledby="csi-pourquoi">
		<div class="oContainer">
			<h2 id="csi-pourquoi" class="oTitle">Pourquoi la vitesse et le référencement comptent</h2>
			<div class="oGrid oGrid--3">
				<div class="oCard">
					<h3>Google favorise les sites rapides</h3>
					<p>La vitesse et la qualité technique font partie des signaux pris en compte par Google, surtout sur mobile.</p>
				</div>
				<div class="oCard">
					<h3>Vos clients cherchent sur mobile</h3>
					<p>Un site qui s’affiche instantanément sur smartphone garde le visiteur au lieu de l’envoyer chez un concurrent.</p>
				</div>
				<div class="oCard">
					<h3>Un site doit générer des demandes</h3>
					<p>Pages de service claires, preuves, appels à l’action et formulaire de devis simple : le site travaille pour vous.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="oSection oSection--alt" aria-labelledby="csi-formules">
		<div class="oContainer">
			<h2 id="csi-formules" class="oTitle">Formules</h2>
			<p class="oIntro">Chaque formule est chiffrée sur devis, selon votre activité et vos contenus.</p>
			<div class="oGrid oGrid--2">
				<div class="oCard">
					<span class="oCard__tag">Essentiel</span>
					<h3>Site Essentiel</h3>
					<p>1 à 3 pages ou une page unique, formulaire de contact, SEO de base et fiche Google Business Profile.</p>
				</div>
				<div class="oCard oCard--accent">
					<span class="oCard__tag">Cœur de gamme</span>
					<h3>Site Vitrine PME</h3>
					<p>5 à 8 pages, rédaction SEO des pages de service, SEO local, formulaire de devis connecté, avis Google, 100/100 PageSpeed visé.</p>
				</div>
				<div class="oCard">
					<span class="oCard__tag">Visibilité</span>
					<h3>Site + Visibilité</h3>
					<p>Site vitrine avec blog, pages de service et de zones, et suivi Search Console pendant les premiers mois.</p>
				</div>
				<div class="oCard">
					<span class="oCard__tag">Refonte</span>
					<h3>Refonte / migration</h3>
					<p>Reprise des contenus, redirections 301, gain de vitesse mesuré avant et après.</p>
				</div>
			</div>
		</div>
	</section>

	<section id="realisations" class="oSection" aria-labelledby="csi-realisations">
		<div class="oContainer">
			<h2 id="csi-realisations" class="oTitle">Mes dernières réalisations</h2>
			<p class="oIntro">Quelques sites récents développés et mis en ligne. Cliquez sur une vignette pour visiter le site.</p>
			<div class="oGrid oGrid--3">
				{
					realisations.map((item) => (
						<article class="oCard csiWork">
							<a class="oMedia" href={item.url} target="_blank" rel="noopener noreferrer">
								<img
									src={item.image}
									alt={`Aperçu du site ${item.name}`}
									loading="lazy"
									decoding="async"
									width="1024"
									height="700"
								/>
							</a>
							<p class="csiWork__sector">{item.sector}</p>
							<h3>
								<a href={item.url} target="_blank" rel="noopener noreferrer">
									{item.name}
								</a>
							</h3>
							<p>{item.description}</p>
							<ul class="csiWork__tags">
								{item.tags.map((tag) => (
									<li>{tag}</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section id="performance" class="oSection oSection--alt" aria-labelledby="csi-performance">
		<div class="oContainer">
			<h2 id="csi-performance" class="oTitle">Des sites notés au maximum</h2>
			<p class="oIntro">
				Rapports PageSpeed Insights (mobile) sur des sites en production : performance, accessibilité, bonnes pratiques
				et SEO au plus haut.
			</p>
			<div class="oGrid oGrid--2 csiProofs">
				<figure class="oMedia">
					<img
						src="/images/realisations/hfe-energie-performance.png"
						alt="Rapport PageSpeed Insights de hfe-energie.fr : 100 en performance, 100 en accessibilité, 100 en bonnes pratiques et 100 en SEO"
						loading="lazy"
						decoding="async"
						width="763"
						height="828"
					/>
					<figcaption>
						<a href="https://hfe-energie.fr/" target="_blank" rel="noopener noreferrer">hfe-energie.fr</a> · 100 · 100 · 100 · 100
					</figcaption>
				</figure>
				<figure class="oMedia">
					<img
						src="/images/realisations/podologue-beligat-performance.png"
						alt="Rapport PageSpeed Insights de podologue-beligat.fr : 100 en performance, 96 en accessibilité, 100 en bonnes pratiques et 100 en SEO"
						loading="lazy"
						decoding="async"
						width="960"
						height="1024"
					/>
					<figcaption>
						<a href="https://podologue-beligat.fr/" target="_blank" rel="noopener noreferrer">podologue-beligat.fr</a> · 100 · 96 · 100 · 100
					</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<section class="oSection" aria-labelledby="csi-methode">
		<div class="oContainer">
			<h2 id="csi-methode" class="oTitle">Méthode</h2>
			<ol class="oSteps oSteps--3">
				<li><strong>Brief</strong>Votre activité, vos clients, votre zone et vos objectifs.</li>
				<li><strong>Maquette</strong>Structure des pages et design validés avant le développement.</li>
				<li><strong>Rédaction SEO</strong>Pages de service et contenus pensés pour vos clients et pour Google.</li>
				<li><strong>Développement</strong>Site Astro rapide, accessible, avec données structurées.</li>
				<li><strong>Mise en ligne</strong>Nom de domaine, redirections, Search Console et fiche Google.</li>
				<li><strong>Suivi</strong>Mesure des performances et ajustements après la mise en ligne.</li>
			</ol>
		</div>
	</section>

	<section class="oSection oSection--alt" aria-labelledby="csi-difference">
		<div class="oContainer oSplit">
			<div>
				<h2 id="csi-difference" class="oTitle">Ce qui me différencie</h2>
				<ul class="oChecks">
					<li>Pas de WordPress ni de plugins à mettre à jour : moins de failles et moins de maintenance</li>
					<li>Formulaires connectés : e-mail, Google Sheets, CRM ou Zapier</li>
					<li>Fiche Google Business Profile optimisée avec le site</li>
					<li>Évolution possible vers un espace client ou une <a href="/developpement-application-sur-mesure/">application sur mesure</a></li>
					<li>Refonte d’un site existant (WordPress, Wix…) vers un site rapide, sans perdre votre référencement</li>
				</ul>
				<ul class="oLinks">
					<li><a href="/blog/site-vitrine-astro-zapier-mailjet/">Comment je crée des sites vitrines rapides et connectés</a></li>
				</ul>
			</div>
			{
				parafiniukQuote && (
					<figure class="oQuote">
						<blockquote>« {parafiniukQuote.quote} »</blockquote>
						<figcaption>
							{parafiniukQuote.author}, {parafiniukQuote.context}
						</figcaption>
					</figure>
				)
			}
		</div>
	</section>

	<section class="oSection" aria-labelledby="csi-zone">
		<div class="oContainer">
			<h2 id="csi-zone" class="oTitle">Zone d’intervention</h2>
			<p class="oIntro">
				Basé à Erquinghem-Lys, je travaille avec les entreprises de Lille, Armentières, Nieppe, Bailleul, Hazebrouck,
				Lomme et de toute la métropole lilloise. Rendez-vous sur place ou à distance.
			</p>
		</div>
	</section>
</OfferLayout>

<style>
	.csiWork {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.csiWork .oMedia {
		margin-bottom: 8px;
	}

	.csiWork__sector {
		margin: 0 !important;
		font-size: 13px;
		font-weight: 600;
		color: var(--color-spot-hover);
	}

	.csiWork__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 6px;
		margin: auto 0 0 !important;
		padding: 0 !important;
		list-style: none;
	}

	.csiWork__tags li {
		margin: 0 !important;
		padding: 4px 10px;
		border-radius: 999px;
		font-size: 12px;
		font-weight: 600;
		color: var(--color-primary);
		background: rgba(47, 58, 143, 0.06);
	}

	.csiProofs .oMedia img {
		max-height: 520px;
		object-fit: contain;
		background: #fff;
	}
</style>
