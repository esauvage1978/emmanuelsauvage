---
import OfferLayout from '../layouts/OfferLayout.astro';
import { testimonials, maltRating, googleRating } from '../data/testimonials';
import { GOOGLE_PROFILE_URL, GOOGLE_REVIEW_URL, LINKEDIN_URL, MALT_PROFILE_URL, SITE_ORIGIN } from '../config/site';

const title = 'À propos – Emmanuel Sauvage, formateur et développeur';
const description =
	'Emmanuel Sauvage, formateur Google Sheets et développeur d’applications près de Lille : parcours, méthode, références et zone d’intervention.';
const h1 = 'Emmanuel Sauvage, formateur Google Sheets et développeur près de Lille';
const lead =
	'Je forme les équipes à Google Sheets, j’automatise leurs fichiers et je développe les applications métier et les sites web dont elles ont besoin. Un seul interlocuteur, du tableur à l’application.';

const profilePageJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	url: `${SITE_ORIGIN}/a-propos/`,
	name: title,
	inLanguage: 'fr-FR',
	mainEntity: { '@id': `${SITE_ORIGIN}/#person` },
};

const skills = [
	'Google Sheets',
	'Google Apps Script',
	'Google Workspace',
	'Looker Studio',
	'Power BI',
	'PHP',
	'Symfony',
	'API Platform',
	'Vue.js',
	'React',
	'MySQL',
	'Astro',
	'Formation',
];
---

<OfferLayout
	title={title}
	description={description}
	h1={h1}
	lead={lead}
	eyebrow="À propos"
	breadcrumb={[{ label: 'À propos' }]}
	badges={['Erquinghem-Lys (59193), près de Lille', 'Développeur depuis 2002', 'Présentiel ou à distance', googleRating.label]}
	primaryCta={{ label: 'Parler de mon projet', href: '/contact/' }}
	secondaryCta={{ label: 'Voir les réalisations', href: '/realisations/' }}
	jsonLd={[profilePageJsonLd]}
	current="a-propos"
	ogImage="/images/og/a-propos.png"
>
	<!-- TODO (Emmanuel) : ajouter une vraie photo professionnelle (indispensable pour la formation). La photo actuelle du site est une illustration Unsplash. -->
	<section class="oSection" aria-labelledby="ap-quoi">
		<div class="oContainer oSplit">
			<div>
				<h2 id="ap-quoi" class="oTitle">Ce que je fais</h2>
				<div class="oProse">
					<p>
						Je suis <strong>formateur et développeur indépendant</strong>. Mon terrain de jeu : les entreprises dont les
						équipes perdent du temps dans des fichiers fragiles, des ressaisies et des outils mal adaptés, ou dont le site
						ne leur apporte aucune demande.
					</p>
					<ul>
						<li><a href="/formation-google-sheets/">Former vos équipes à Google Sheets</a> et à <a href="/formation-apps-script/">Apps Script</a></li>
						<li><a href="/automatisation-google-sheets/">Automatiser vos fichiers Google Sheets</a></li>
						<li><a href="/developpement-application-sur-mesure/">Développer des applications métier sur mesure</a>, et <a href="/refonte-application-web/">maintenir ou refondre</a> l’existant</li>
						<li><a href="/creation-site-internet/">Créer des sites internet</a> rapides et bien référencés</li>
					</ul>
					<p>
						Ma particularité : je conçois moi-même des outils Google Sheets et Apps Script utilisés à grande échelle, ce
						qui nourrit mes formations. Et quand un besoin dépasse le tableur, je sais construire l’application qui prend
						le relais : plus de 15 applications développées à ce jour.
					</p>
					<p>
						Je développe aussi mes propres services en ligne : <a href="/realisations/#saas">Webhooky, AlertJet et LnkX</a>.
					</p>
				</div>
			</div>
			<div class="oCard">
				<h3>En pratique</h3>
				<dl class="apMeta">
					<div><dt>Localisation</dt><dd>Erquinghem-Lys (59193), près de Lille et d’Armentières</dd></div>
					<div><dt>Modalités</dt><dd>En présentiel dans vos locaux (Lille et Hauts-de-France) ou à distance</dd></div>
					<!-- TODO (Emmanuel) : confirmer ce délai de réponse. -->
					<div><dt>Réactivité</dt><dd>Réponse en général sous 24 à 48 h ouvrées</dd></div>
					<div><dt>Langues</dt><dd>Français · anglais technique</dd></div>
				</dl>
				<p>
					<a href={GOOGLE_PROFILE_URL} target="_blank" rel="noopener noreferrer">Avis Google</a> ·
					<a href={MALT_PROFILE_URL} target="_blank" rel="noopener noreferrer">Profil Malt</a> ·
					<a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn</a>
				</p>
			</div>
		</div>
	</section>

	<section class="oSection oSection--alt" aria-labelledby="ap-parcours">
		<div class="oContainer">
			<h2 id="ap-parcours" class="oTitle">Parcours</h2>
			<!-- Début d’activité en 2002 et 15+ applications : confirmés par Emmanuel (28/09/2026). TODO (Emmanuel) : confirmer les intitulés et les années du parcours à la CNAM ; date de début et nombre d’étudiants accompagnés comme mentor OpenClassrooms. -->
			<ol class="apTimeline">
				<li>
					<p class="apTimeline__when">2002</p>
					<h3>DUT Informatique, IUT A de Lille</h3>
					<p>Le point de départ d’un parcours de plus de 20 ans dans l’informatique.</p>
				</li>
				<li>
					<p class="apTimeline__when">Organisations complexes</p>
					<h3>Caisse nationale de l’assurance maladie</h3>
					<p>
						Une grande partie de ma carrière dans des environnements exigeants en fiabilité et en service, avec des rôles
						techniques, de management et de formation. On y apprend la différence entre une solution présentable et une
						solution qui tient dans la durée.
					</p>
				</li>
				<li>
					<p class="apTimeline__when">2019</p>
					<h3>Parcours OpenClassrooms « Développeur d’application PHP / Symfony »</h3>
					<p>Puis mentor OpenClassrooms : accompagner des étudiants développeurs, un exercice de pédagogie au quotidien.</p>
				</li>
				<li>
					<p class="apTimeline__when">Aujourd’hui</p>
					<h3>Formateur et développeur indépendant</h3>
					<p>
						Missions pour des entreprises de toutes tailles, dont des outils Google Sheets et Apps Script pour Decathlon,
						un back-office pour Mon Coach Brico et des sites vitrines pour des entreprises de la métropole lilloise.
					</p>
				</li>
			</ol>
		</div>
	</section>

	<section class="oSection" aria-labelledby="ap-methode">
		<div class="oContainer oGrid oGrid--2">
			<div>
				<h2 id="ap-methode" class="oTitle">Comment je travaille</h2>
				<ol class="oSteps">
					<li><strong>Écoute</strong>Votre besoin, vos irritants, vos outils existants et vos délais.</li>
					<li><strong>Cadrage</strong>Un périmètre réaliste, les risques, un plan d’action.</li>
					<li><strong>Réalisation</strong>Des itérations courtes et de la visibilité sur l’avancement.</li>
					<li><strong>Transmission</strong>Documentation et formation, pour que vous restiez autonomes.</li>
				</ol>
			</div>
			<div>
				<h2 class="oTitle">Pour qui je ne suis pas le bon interlocuteur</h2>
				<div class="oProse">
					<p>
						Si vous cherchez uniquement le prix au jour le plus bas, sans critère de qualité, nous ne serons pas alignés :
						ce type d’économie se paie en incidents.
					</p>
					<p>
						<!-- TODO (Emmanuel) : confirmer (absence de dépannage pour les particuliers). -->
						Je ne fais pas de dépannage informatique pour les particuliers. Et si l’objectif est un site « pour le look »
						sans lien avec vos clients ou vos demandes, je préfère être transparent : ce n’est pas là que j’apporte le plus
						de valeur.
					</p>
				</div>
				<ul class="oLinks" aria-label="Compétences">
					{skills.map((s) => <li><span class="apSkill">{s}</span></li>)}
				</ul>
			</div>
		</div>
	</section>

	<section class="oSection oSection--alt" aria-labelledby="ap-avis">
		<div class="oContainer">
			<h2 id="ap-avis" class="oTitle">Recommandations</h2>
			<!-- Témoignage de Yann Philippe (Decathlon SAS) autorisé. TODO (Emmanuel) : autorisation des témoignages Mon Coach Brico et Maître Parafiniuk. Notes vérifiées le 28/09/2026. -->
			<p class="oIntro">
				<a href={GOOGLE_PROFILE_URL} target="_blank" rel="noopener noreferrer">{googleRating.label}</a> ·
				<a href={MALT_PROFILE_URL} target="_blank" rel="noopener noreferrer">{maltRating.label}</a>
			</p>
			<div class="oGrid oGrid--3">
				{
					testimonials.map((t) => (
						<figure class="oQuote">
							<blockquote>« {t.quote} »</blockquote>
							<figcaption>
								{t.author}, {t.context}
							</figcaption>
						</figure>
					))
				}
			</div>
			<p class="oNote">
				Vous avez travaillé avec moi ?
				<a href={GOOGLE_REVIEW_URL} target="_blank" rel="noopener noreferrer">Laissez un avis Google</a>.
			</p>
		</div>
	</section>

	<section class="oSection" aria-labelledby="ap-zone">
		<div class="oContainer">
			<h2 id="ap-zone" class="oTitle">Zone d’intervention</h2>
			<p class="oIntro">
				Basé à Erquinghem-Lys, j’interviens en présentiel à Lille, Armentières, dans la métropole lilloise et dans les
				Hauts-de-France (Flandre intérieure, Artois). Formations et projets se déroulent aussi à distance, partout en
				France.
			</p>
		</div>
	</section>
</OfferLayout>

<style>
	.apMeta {
		display: grid;
		gap: 10px;
		margin: 0 0 14px;
	}

	.apMeta dt {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.apMeta dd {
		margin: 0;
	}

	.apTimeline {
		display: grid;
		gap: 16px;
		margin: 0;
		padding: 0 0 0 20px;
		list-style: none;
		border-left: 2px solid rgba(47, 58, 143, 0.18);
	}

	.apTimeline li {
		position: relative;
		padding: 16px 18px;
		border-radius: 14px;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
	}

	.apTimeline li::before {
		content: '';
		position: absolute;
		left: -28px;
		top: 22px;
		width: 12px;
		height: 12px;
		border-radius: 50%;
		background: var(--color-spot);
		box-shadow: 0 0 0 4px #fff;
	}

	.apTimeline h3 {
		margin: 0 0 6px;
		font-size: 1.05rem;
		color: var(--color-primary);
	}

	.apTimeline p {
		margin: 0;
		line-height: 1.55;
	}

	.apTimeline__when {
		margin-bottom: 4px !important;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-spot-hover);
	}

	.apSkill {
		display: inline-flex;
		padding: 7px 12px;
		border-radius: 999px;
		font-size: 13px;
		font-weight: 600;
		color: var(--color-primary);
		background: #fff;
		border: 1px solid rgba(47, 58, 143, 0.18);
	}
</style>
